6cc\u0631-\u0642\u06cc\u0645\u062a-\u0627\u0646\u0648\u0627\u0639-\u0631\u0648\u063a\u0646-\u0645\u0648\u062a\u0648\u0631-\u0628\u0646\u0632\u06cc\u0646\u06cc-\u062f\u0631-\u0628\u0627\u0632\u0627\u0631-\u0631\u0627-\u0627\u0641\u0632\u0627\u06cc\u0634-\u0645\u06cc-\u062f\u0647\u062f\">\u0628\u0631 \u0627\u0633\u0627\u0633 \u0646\u0627\u0645\u0647 \u0631\u0633\u0645\u06cc \u0627\u0646\u062c\u0645\u0646 \u067e\u0627\u0644\u0627\u06cc\u0634\u06af\u0627\u0647\u200c\u0647\u0627\u06cc \u0631\u0648\u063a\u0646\u200c\u0633\u0627\u0632\u06cc \u0627\u06cc\u0631\u0627\u0646\u060c \u0631\u0648\u063a\u0646 \u0645\u0648\u062a\u0648\u0631 \u0628\u0646\u0632\u06cc\u0646\u06cc \u0627\u0632 \u0634\u0645\u0648\u0644 \u0642\u06cc\u0645\u062a\u200c\u06af\u0630\u0627\u0631\u06cc \u062a\u062b\u0628\u06cc\u062a\u06cc \u062e\u0627\u0631\u062c \u0634\u062f\u0647 \u0627\u0633\u062a. \u0628\u0647 \u0627\u06cc\u0646 \u062a\u0631\u062a\u06cc\u0628\u060c \u062a\u0648\u0644\u06cc\u062f\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u0631\u0648\u063a\u0646 \u0645\u0648\u062a\u0648\u0631 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u0646\u062f \u0645\u0637\u0627\u0628\u0642 \u0636\u0648\u0627\u0628\u0637 \u062a\u0639\u06cc\u06cc\u0646\u200c\u0634\u062f\u0647 \u0646\u0633\u0628\u062a \u0628\u0647 \u0627\u0635\u0644\u0627\u062d \u0642\u06cc\u0645\u062a \u0645\u062d\u0635\u0648\u0644\u0627\u062a \u062e\u0648\u062f \u0627\u0642\u062f\u0627\u0645 \u06a9\u0646\u0646\u062f\u061b \u062a\u0635\u0645\u06cc\u0645\u06cc \u06a9\u0647 \u0627\u062d\u062a\u0645\u0627\u0644 \u062a\u063a\u06cc\u06cc\u0631 \u0642\u06cc\u0645\u062a \u0627\u0646\u0648\u0627\u0639 \u0631\u0648\u063a\u0646 \u0645\u0648\u062a\u0648\u0631 \u0628\u0646\u0632\u06cc\u0646\u06cc \u062f\u0631 \u0628\u0627\u0632\u0627\u0631 \u0631\u0627 \u0627\u0641\u0632\u0627\u06cc\u0634 \u0645\u06cc\u200c\u062f\u0647\u062f.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u0628\u0647 \u06af\u0632\u0627\u0631\u0634 <a href=\"https:\/\/Digiato.com\" data-type=\"link\" data-id=\"Digiato.com\">\u062f\u06cc\u062c\u06cc\u0627\u062a\u0648<\/a>\u060c \u0627\u0646\u062c\u0645\u0646 \u067e\u0627\u0644\u0627\u06cc\u0634\u06af\u0627\u0647\u200c\u0647\u0627\u06cc \u0631\u0648\u063a\u0646\u200c\u0633\u0627\u0632\u06cc \u0627\u06cc\u0631\u0627\u0646 \u062f\u0631 \u0646\u0627\u0645\u0647\u200c\u0627\u06cc \u0628\u0647 \u0645\u062f\u06cc\u0631\u0627\u0646 \u0639\u0627\u0645\u0644 \u0686\u0647\u0627\u0631 \u0634\u0631\u06a9\u062a \u0628\u0632\u0631\u06af \u062a\u0648\u0644\u06cc\u062f\u06a9\u0646\u0646\u062f\u0647 \u0631\u0648\u0627\u0646\u06a9\u0627\u0631 \u06a9\u0634\u0648\u0631 \u0634\u0627\u0645\u0644 \u0646\u0641\u062a \u0628\u0647\u0631\u0627\u0646\u060c \u0646\u0641\u062a \u0633\u067e\u0627\u0647\u0627\u0646\u060c \u0646\u0641\u062a \u067e\u0627\u0631\u0633 \u0648 \u0646\u0641\u062a \u0627\u06cc\u0631\u0627\u0646\u0648\u0644 \u0627\u0639\u0644\u0627\u0645 \u06a9\u0631\u062f\u0647 \u0627\u0633\u062a \u06a9\u0647 \u0628\u0631 \u0627\u0633\u0627\u0633 \u0645\u0635\u0648\u0628\u0647 \u062c\u062f\u06cc\u062f \u0633\u062a\u0627\u062f \u062a\u0646\u0638\u06cc\u0645 \u0628\u0627\u0632\u0627\u0631 \u06a9\u0634\u0648\u0631\u060c \u0631\u0648\u063a\u0646 \u0645\u0648\u062a\u0648\u0631 \u0628\u0646\u0632\u06cc\u0646\u06cc \u062f\u06cc\u06af\u0631 \u0645\u0634\u0645\u0648\u0644 \u0642\u06cc\u0645\u062a\u200c\u06af\u0630\u0627\u0631\u06cc \u062a\u062b\u0628\u06cc\u062a\u06cc \u0646\u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u0645\u0637\u0627\u0628\u0642 \u0627\u06cc\u0646 \u0646\u0627\u0645\u0647\u060c \u0627\u0641\u0632\u0627\u06cc\u0634 \u0642\u06cc\u0645\u062a \u0631\u0648\u063a\u0646 \u0645\u0648\u062a\u0648\u0631 \u0628\u0646\u0632\u06cc\u0646\u06cc \u0628\u0627\u06cc\u062f \u062f\u0631 \u0686\u0627\u0631\u0686\u0648\u0628 \u0636\u0648\u0627\u0628\u0637 \u0633\u0627\u0632\u0645\u0627\u0646 \u062d\u0645\u0627\u06cc\u062a \u0627\u0632 \u0645\u0635\u0631\u0641\u200c\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u0648 \u062a\u0648\u0644\u06cc\u062f\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u0627\u0646\u062c\u0627\u0645 \u0634\u0648\u062f. \u0628\u0646\u0627\u0628\u0631\u0627\u06cc\u0646\u060c \u062e\u0631\u0648\u062c \u0627\u0632 \u0646\u0638\u0627\u0645 \u0642\u06cc\u0645\u062a\u200c\u06af\u0630\u0627\u0631\u06cc \u062a\u062b\u0628\u06cc\u062a\u06cc \u0628\u0647 \u0645\u0639\u0646\u0627\u06cc \u0627\u062e\u062a\u06cc\u0627\u0631 \u0646\u0627\u0645\u062d\u062f\u0648\u062f \u0634\u0631\u06a9\u062a\u200c\u0647\u0627 \u0628\u0631\u0627\u06cc \u0627\u0641\u0632\u0627\u06cc\u0634 \u0642\u06cc\u0645\u062a \u0645\u062d\u0635\u0648\u0644\u0627\u062a \u0646\u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f.<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">\u0647\u0645\u0686\u0646\u06cc\u0646 \u062a\u0648\u0644\u06cc\u062f\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u0645\u0648\u0638\u0641 \u0634\u062f\u0647\u200c\u0627\u0646\u062f \u0646\u0631\u062e\u200c\u0647\u0627\u06cc \u0646\u0647\u0627\u06cc\u06cc \u0645\u0635\u0648\u0628 \u062e\u0648\u062f \u0631\u0627 \u0628\u0631\u0627\u06cc \u0646\u0638\u0627\u0631\u062a \u0628\u0631 \u0628\u0627\u0632\u0627\u0631 \u0628\u0647 \u0645\u0631\u0627\u062c\u0639 \u0645\u0631\u0628\u0648\u0637 \u0627\u0639\u0644\u0627\u0645 \u06a9\u0646\u0646\u062f. \u0627\u06cc\u0646 \u0645\u0648\u0636\u0648\u0639 \u0646\u0634\u0627\u0646 \u0645\u06cc\u200c\u062f\u0647\u062f \u06a9\u0647 \u0628\u0627 \u0648\u062c\u0648\u062f \u062a\u063a\u06cc\u06cc\u0631 \u0633\u0627\u0632\u0648\u06a9\u0627\u0631 \u0642\u06cc\u0645\u062a\u200c\u06af\u0630\u0627\u0631\u06cc\u060c \u0646\u0638\u0627\u0631\u062a \u0628\u0631 \u0642\u06cc\u0645\u062a \u0645\u062d\u0635\u0648\u0644\u0627\u062a \u0647\u0645\u0686\u0646\u0627\u0646 \u0627\u062f\u0627\u0645\u0647 \u062e\u0648\u0627\u0647\u062f \u062f\u0627\u0634\u062a.<\/p>\n\n\n<div class=\"wp-block-image\">\n<figure class=\"aligncenter size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"768\" height=\"1024\" src=\"https: